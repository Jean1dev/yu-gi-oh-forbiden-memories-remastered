.claude/projects/*

node_modules/
dist/
.next/
.turbo/

# Local environment secrets (Supabase URL/keys, etc.) — never versioned.
.env
.env.local
.env.*.local

# Supabase CLI local link/session state — machine-specific, never versioned.
supabase/.temp/

# Vercel CLI local link/session state — machine-specific, never versioned.
.vercel/

# Card Database ingestion artifacts (banco-de-cartas/F01, Decision 5):
# regenerated by `pnpm data:ingest` in every environment, never versioned.
packages/data/generated/

# Upstream Forbidden Memories datamine cached by `data:extract-fm-duelist`.
# Re-downloadable, only needed when a new duelist is extracted.
packages/data/.cache/
