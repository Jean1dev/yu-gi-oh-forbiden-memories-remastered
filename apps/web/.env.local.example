# Copy to `apps/web/.env.local` (gitignored) before running `pnpm dev`.
#
# Two profiles are supported. The local one is the default for day-to-day work:
# it needs no credentials, is resettable (`pnpm db:reset`) and its keys are the
# fixed demo keys the Supabase CLI ships with, so they are safe to version here.

# --- Profile A: local stack (`pnpm db:start`) -------------------------------
# Run `pnpm db:status` to print these for your machine and paste the values in.

# Read by the browser client (`createSupabaseClient`).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Read by the service-role client (`createSupabaseServiceRoleClient`), which is
# server-only: it is what `POST /api/account/bootstrap` uses to seed a new
# player's initial deck through the `persist_initial_deck` RPC. Deliberately
# NOT prefixed with `NEXT_PUBLIC_` so it can never reach a client bundle.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=

# Only `pnpm test:integration` reads this one. Locally it is the same value as
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY above — the runtime and the tests just
# disagree on the variable name.
SUPABASE_ANON_KEY=

# --- Profile B: shared test project ----------------------------------------
# The remote `yugioh` project already has migrations 0001-0007 applied. Swap the
# four URLs/keys above for its values; get them with:
#   npx supabase login
#   npx supabase projects api-keys --project-ref plzmowrjvjenwjqlvxhw --reveal
# It returns both key formats: `anon`/`service_role` (legacy JWT, what
# SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY expect) and
# `sb_publishable_...`/`sb_secret_...` (new format, what
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY expects).
#
# NEXT_PUBLIC_SUPABASE_URL=https://plzmowrjvjenwjqlvxhw.supabase.co
# SUPABASE_URL=https://plzmowrjvjenwjqlvxhw.supabase.co
