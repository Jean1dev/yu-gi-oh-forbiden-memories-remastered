{
  "name": "@yugioh/data",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./art": "./src/art/index.ts",
    "./catalog": "./src/catalog/index.ts",
    "./catalog/disk": "./scripts/load-catalog-from-disk.ts",
    "./drops": "./src/drops/index.ts",
    "./drops/disk": "./scripts/load-drop-table-from-disk.ts",
    "./fusion": "./src/fusion/index.ts",
    "./fusion/disk": "./scripts/load-fusion-table-from-disk.ts",
    "./guardian-stars": "./src/guardian-stars/index.ts",
    "./ingestion": "./src/ingestion/index.ts",
    "./roster": "./src/roster/index.ts",
    "./terrain": "./src/terrain/index.ts",
    "./terrain/disk": "./scripts/load-terrain-table-from-disk.ts",
    "./validation": "./src/validation/index.ts"
  },
  "scripts": {
    "data:guardian-matrix": "node scripts/build-guardian-matrix.ts",
    "data:ingest": "node scripts/ingest-cards.ts",
    "data:enrich": "node scripts/enrich-cards.ts",
    "data:download-art": "node scripts/download-card-art.ts",
    "data:rollout-card-frame": "node scripts/rollout-card-frame.ts",
    "data:prices-seed": "node scripts/generate-card-prices-seed.ts",
    "data:test-duelist": "node scripts/generate-test-duelist.ts",
    "data:validate": "node scripts/validate-cards.ts",
    "data:validate-fusions": "node scripts/validate-fusions.ts",
    "roster:validate": "node scripts/validate-roster.ts",
    "data:validate-terrain": "node scripts/validate-terrain-matrix.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --dir src",
    "test:integration": "vitest run --dir tests"
  },
  "dependencies": {
    "@yugioh/shared": "workspace:*",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "fast-check": "4.9.0",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
